{
  "name": "dsh-resume-matcher",
  "version": "0.1.0",
  "description": "简历诊所 · HR 视角深度简历优化：解析 PDF/DOCX 简历与岗位 JD，五步审计（第一印象/地毯式审计/修改蓝图/重写简历/最终裁决），报告与优化后简历存档，侧栏「简历诊所」面板管理。纯技能零 API key，分析由会话模型完成。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "lab",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "resume",
    "career",
    "hr",
    "interview"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
